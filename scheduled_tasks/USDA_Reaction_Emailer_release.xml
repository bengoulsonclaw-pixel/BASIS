<?xml version="1.0" encoding="UTF-16"?>

<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">

  <RegistrationInfo>

    <Description>Auto-builds and emails the USDA Acreage &amp; Grain Stocks reaction note when NASS posts the 30 June reports. Runs every 30 min 11:10-15:10 daily; the script no-ops until released, sends once to the 'usda_reaction' recipients, then dedups via a marker.</Description>

    <URI>\USDA Reaction Emailer (release)</URI>

  </RegistrationInfo>

  <Principals>

    <Principal id="Author">

      <UserId>S-1-5-21-2336263511-2746669706-1963067531-1001</UserId>

      <LogonType>InteractiveToken</LogonType>

    </Principal>

  </Principals>

  <Settings>

    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>

    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>

    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>

    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>

    <StartWhenAvailable>true</StartWhenAvailable>

    <IdleSettings>

      <Duration>PT10M</Duration>

      <WaitTimeout>PT1H</WaitTimeout>

      <StopOnIdleEnd>true</StopOnIdleEnd>

      <RestartOnIdle>false</RestartOnIdle>

    </IdleSettings>

    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>

  </Settings>

  <Triggers>

    <CalendarTrigger>

      <StartBoundary>2026-06-28T11:10:00-05:00</StartBoundary>

      <Repetition>

        <Interval>PT30M</Interval>

        <Duration>PT4H</Duration>

        <StopAtDurationEnd>true</StopAtDurationEnd>

      </Repetition>

      <ScheduleByDay>

        <DaysInterval>1</DaysInterval>

      </ScheduleByDay>

    </CalendarTrigger>

  </Triggers>

  <Actions Context="Author">

    <Exec>

      <Command>C:\Users\Ben\OneDrive\Desktop\AI\strategy-dashboard\.venv\Scripts\python.exe</Command>

      <Arguments>"C:\Users\Ben\OneDrive\Desktop\AI\strategy-dashboard\usda_reaction_scheduled_email.py"</Arguments>

      <WorkingDirectory>C:\Users\Ben\OneDrive\Desktop\AI\strategy-dashboard</WorkingDirectory>

    </Exec>

  </Actions>

</Task>
