<?xml version="1.0" encoding="UTF-16"?>

<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">

  <RegistrationInfo>

    <Author>BENSGALAXYBOOK2\Ben</Author>

    <Description>Fetches OPEC's Monthly Oil Market Report the moment it posts (~04:00 ET / 10:00 Vienna, timing drifts) and emails the branded synopsis. Polls every 30 min 04:00-12:00 daily; the script no-ops instantly outside the 8th-18th release window or once this month's edition is sent (marker), so Chrome only opens while actually waiting for the release. Honours the dashboard automation on/off flag.</Description>

    <URI>\OPEC MOMR Synopsis</URI>

  </RegistrationInfo>

  <Principals>

    <Principal id="Author">

      <UserId>S-1-5-21-2336263511-2746669706-1963067531-1001</UserId>

      <LogonType>InteractiveToken</LogonType>

    </Principal>

  </Principals>

  <Settings>

    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>

    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>

    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>

    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>

    <StartWhenAvailable>true</StartWhenAvailable>

    <IdleSettings>

      <Duration>PT10M</Duration>

      <WaitTimeout>PT1H</WaitTimeout>

      <StopOnIdleEnd>true</StopOnIdleEnd>

      <RestartOnIdle>false</RestartOnIdle>

    </IdleSettings>

  </Settings>

  <Triggers>

    <CalendarTrigger>

      <StartBoundary>2026-06-28T04:00:00</StartBoundary>

      <Repetition>

        <Interval>PT30M</Interval>

        <Duration>PT8H</Duration>

        <StopAtDurationEnd>true</StopAtDurationEnd>

      </Repetition>

      <ScheduleByDay>

        <DaysInterval>1</DaysInterval>

      </ScheduleByDay>

    </CalendarTrigger>

  </Triggers>

  <Actions Context="Author">

    <Exec>

      <Command>C:\Users\Ben\OneDrive\Desktop\AI\strategy-dashboard\run_opec_monthly.bat</Command>

    </Exec>

  </Actions>

</Task>
