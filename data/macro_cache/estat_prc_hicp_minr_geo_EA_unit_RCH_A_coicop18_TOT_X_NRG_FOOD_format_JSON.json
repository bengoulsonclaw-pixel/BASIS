-month average rate of change,&nbsp;comparing\u202fthe average index over a 12-month period to the average index previous 12-month period.</li></ul><p><br></p><p>All the rates are calculated from the monthly HICP indices.&nbsp;</p>", "id": "PRC_HICP_MINR", "agencyId": "ESTAT", "version": "1.0", "datastructure": {"id": "PRC_HICP_MINR", "agencyId": "ESTAT", "version": "22.0"}, "annotation": [{"type": "CREATED", "date": "2026-01-27T09:31:20+0100"}, {"type": "DISSEMINATION_DOI_XML", "title": "<adms:identifier xmlns:adms=\"http://www.w3.org/ns/adms#\" xmlns:skos=\"http://www.w3.org/2004/02/skos/core.html\" xmlns:dct=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"><adms:Identifier rdf:about=\"https://doi.org/10.2908/PRC_HICP_MINR\"><skos:notation rdf:datatype=\"http://purl.org/spar/datacite/doi\">10.2908/PRC_HICP_MINR</skos:notation><dct:creator rdf:resource=\"http://publications.europa.eu/resource/authority/corporate-body/ESTAT\"/><dct:issued rdf:datatype=\"http://www.w3.org/2001/XMLSchema#date\">2026-01-27</dct:issued></adms:Identifier></adms:identifier>"}, {"type": "DISSEMINATION_EXPLANATORY_LINK", "title": "text-category", "href": "https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf"}, {"type": "DISSEMINATION_EXPLANATORY_LINK", "title": "text-category", "href": "https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf", "text": "Information note"}, {"type": "DISSEMINATION_EXPLANATORY_LINK", "title": "text-category", "href": "https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf"}, {"type": "DISSEMINATION_OBJECT_TYPE", "title": "DATASET"}, {"type": "DISSEMINATION_TIMESTAMP_DATA", "date": "2026-08-19T11:00:00+0200"}, {"type": "DISSEMINATION_TIMESTAMP_GLOBAL", "date": "2026-08-19T11:00:00+0200"}, {"type": "DISSEMINATION_TIMESTAMP_PLANNED"