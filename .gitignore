# ── Secrets / API keys — NEVER commit ─────────────────────────────────────────
*key*.txt
*_key.txt
*.key
*.pem
.env
.env.*
credentials.json
token.json
data/eia_key.txt
data/unsplash_key.txt

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── Virtual environment (large, machine-specific) ─────────────────────────────
.venv/
venv/
env/

# ── Deploy artifact: bundled Playwright browser ───────────────────────────────
playwright-browsers/

# ── Data stores: snapshot/equities/price_store are COMMITTED — they hold
#    non-regenerable history (own30_history, stir_curve_history, append-only
#    fundamentals). Only pure computation outputs stay ignored. ────────────────
data/signals/
data/wasde_snapshots/

# ── Generated reports / exports ───────────────────────────────────────────────
data/*.pdf
data/*.xlsx
history_check.txt

# ── User-editable runtime state (managed in-app; ignore the churn, and keep
#    git operations from ever touching the user's deliberate settings) ─────────
data/sector_filter.json
data/filter_default.json
data/ui_prefs.json
data/alerts.json
data/automation.json
data/email_recipients.json
data/wasde_consensus.json

# ── Colleague-access accounts / login secrets — local to each install, never synced.
#    Ben provisions colleagues directly on each environment (local + VPS) via the in-app
#    admin panel; the VPS's own users.json/cookie key never round-trips through git. ──────
data/users.json
data/.auth_cookie_key.txt
data/email_send_log.jsonl
data/auth_settings.json
data/usage_log.jsonl

# ── OS / editor cruft ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Browser automation profile (cookies / session data — never commit) ───────
data/.pm_chrome_profile/
# Goldhub session. This one holds a LIVE authenticated Google session for
# basisreports@gmail.com — the same account the Morning Coffee mailer sends from.
# This repo pushes to GitHub and syncs to the VPS, so committing it would put a
# working login for that mailbox in two places it has no business being.
data/.wgc_chrome_profile/
# WGC downloads are licensed data — kept local until the redistribution terms are
# settled (see docs/gold-signal-engine.md).
data/wgc_inbox/

# Local server logs (written by launch_basis.ps1)
logs/

# Calendar feed cache — a transient copy of an external feed, and committing it is
# actively dangerous: a fresh checkout (the VPS) with a dead feed would serve
# whatever was frozen in it as though it were this week's schedule. A test fixture
# once reached this file and would have printed a fabricated release in a client PDF.
data/econ_calendar_cache.json

# runtime locks / guard markers - never version these (a stale lock on main made the VPS think a pull was running)
data/snapshot/.eq_pull.lock
data/snapshot/.pull_driver.lock
data/signal_cache/ledger_guard_*.json

# Gold-engine scratch: debug rasterisations and pickled intermediates written
# during development. 1.7 MB of these reached the repo (and therefore the VPS)
# before the audit caught them.
data/gold_store/_*
tmp_*.pkl

# Generated report PDFs (rebuilt on demand / by the scheduled sender)
reports/*.pdf
